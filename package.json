{
  "name": "chessmerge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --open",
    "dev:backend": "convex-hosting init && convex dev",
    "predev": "convex-hosting init && convex dev --until-success && convex dev --once --run-sh \"node setup.mjs --once\" ",
    "build:app": "tsc -b && vite build",
    "deploy": "convex-hosting deploy --build \"pnpm run build:app\" --dist dist/client --html-handling none --not-found-handling single-page-application",
    "deploy:dev": "convex-hosting deploy --dev --build \"pnpm run build:app\" --dist dist/client --html-handling none --not-found-handling single-page-application",
    "lint": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives",
    "lint:strict": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc -b",
    "type-check:watch": "tsc -b --watch",
    "type-check:convex": "tsc --project convex/tsconfig.json --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "node ./scripts/run-e2e-smoke.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@oslojs/crypto": "^1.0.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@robolex/sure": "^0.12.0",
    "@samebase/convex-hosting": "0.5.0",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59",
    "@tscu/dependent": "npm:@jsr/tscu__dependent@^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "dependent-ts": "^0.0.4",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "convex-test": "^0.0.56",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jose": "^6.2.10",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "overrides": {
      "@humanfs/node": "0.16.8",
      "browserslist": "4.29.3",
      "js-yaml": "4.3.2",
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2",
      "yaml": "2.8.3"
    }
  }
}

{
  "name": "chessmerge",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --open",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success && convex dev --once --run-sh \"node setup.mjs --once\" ",
    "build": "node ./scripts/build-cloudflare.ts",
    "build:app": "tsc -b && vite build",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "lint": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives",
    "lint:strict": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc -b",
    "type-check:watch": "tsc -b --watch",
    "type-check:convex": "tsc --project convex/tsconfig.json --noEmit",
    "preview": "wrangler dev --config ./wrangler.jsonc --port 8787",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "node ./scripts/run-e2e-smoke.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@oslojs/crypto": "^1.0.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@robolex/sure": "^0.12.0",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-start": "1.167.65",
    "@tscu/dependent": "npm:@jsr/tscu__dependent@^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "dependent-ts": "^0.0.4",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.1.4",
    "@vitest/ui": "^3.1.4",
    "convex-test": "^0.0.37",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jose": "^6.2.10",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^7.3.6",
    "vitest": "^3.1.4",
    "wrangler": "4.123.0"
  }
}
